# Optional Linux desktop overrides.
#
# The normal amd64 desktop port opens as a regular resizable window. Uncomment
# this to ask Writing Environment to start in borderless maximized presentation mode.
# WRITING_ENVIRONMENT_APPLIANCE=1
#
# NVIDIA systems automatically use WebKitGTK's shared-memory renderer to avoid
# DRM/GBM permission failures. Either value below overrides automatic detection.
# WEBKIT_DISABLE_DMABUF_RENDERER=1
# WEBKIT_DISABLE_DMABUF_RENDERER=0
